---
import Base from '@layouts/Base.astro';
import PageHero from '@components/PageHero.astro';
import Steps from '@components/Steps.astro';
import PriceTable from '@components/PriceTable.astro';
import Faq from '@components/Faq.astro';
import CtaBooking from '@components/CtaBooking.astro';
import { tarifs } from '@data/site';

const situations = [
  ['Comportements inhabituels', 'Agressivité, fatigue, léchage intempestif, destructions, fugues, marquage, piquage…'],
  ['Stress et séparation', 'Anxiété liée à l’absence du maître, d’un petit ou d’un congénère.'],
  ['Un nouveau venu', 'L’arrivée d’un membre dans la famille, le troupeau ou la meute.'],
  ['Peurs et phobies', 'Bruits, montée en voiture, entrée dans un bâtiment, refus d’obstacle…'],
  ['Baisse de moral', 'Perte d’appétit, état léthargique.'],
  ['Relations', 'Conflits avec des congénères ou avec des humains.'],
  ['Convalescence', 'Après un accident ou une opération.'],
];
const histoires = [
  { name: 'Foggy', tag: 'Chien · très fusionnel', text: 'Après plusieurs mois seul avec sa maîtresse lors d’un déplacement professionnel, il fallait redéfinir un cadre pour que chacun retrouve sa juste place. Et Foggy, sa place de chien.' },
  { name: 'Pomponnette', tag: 'Chatte · adoptée à 8 ans', text: 'Sa nouvelle maîtresse la trouvait trop timide. Après la perte de son maître et un passage en famille d’accueil, Pomponnette avait surtout besoin de temps — et de ne plus être comparée à l’ancien chat de la maison.' },
  { name: 'Ubert', tag: 'Chien · 2 ans · stress en voiture', text: 'Vomissements, tremblements, bave : chaque trajet était un calvaire, et le stress de l’une nourrissait celui de l’autre. L’origine a été identifiée très vite : un premier trajet difficile, bébé. Après les équilibrations et quelques conseils, le retour s’est fait dans le plus grand calme.' },
];
---

<Base
  title="Kinésiologie animale à Chambéry"
  description="Kinésiologie animale à Bassens, près de Chambéry : stress, peurs, changements de vie de votre animal. Séance d’1 h 15 avec vous. 70 €."
  path="/kinesiologie-animale"
  heroDark
>
  <PageHero
    scene="branches"
    eyebrow="Kinésiologie animale à Chambéry · Bassens"
    title="Comprendre votre animal, <em>renforcer le lien</em>."
    intro="Chien, chat, cheval : la kinésiologie crée un espace de communication entre votre animal et vous, pour mieux comprendre ce qu’il traverse."
    number="03"
  >
  </PageHero>

  <section class="section" aria-labelledby="sit-title">
    <div class="container">
      <div class="sit__head">
        <p class="eyebrow" data-reveal>Pourquoi consulter ?</p>
        <h2 id="sit-title" data-split>Quand le comportement <em>parle</em> pour lui.</h2>
      </div>
      <ul class="sit__list" role="list">
        {situations.map(([t, d], i) => (
          <li class="sit" data-reveal={String((i % 2) * 0.08)}>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Steps
    title="Une séance, <em>à deux</em>."
    intro="La séance dure 1 h 15 et a lieu uniquement au cabinet de Bassens."
    steps={[
      { title: 'L’échange', text: 'Nous parlons de votre animal, de son histoire, de son quotidien et de ce qui vous préoccupe.' },
      { title: 'Le test musculaire', text: 'Il guide la séance vers l’origine du stress, en tenant compte du lien qui vous unit à votre animal.' },
      { title: 'Les équilibrations', text: 'Des corrections douces pour apaiser le stress identifié, chez l’animal comme chez son humain.' },
      { title: 'Les conseils', text: 'Quelques pistes concrètes pour le quotidien, et si besoin une orientation vers un professionnel partenaire.' },
    ]}
  />

  <section class="section stories" aria-labelledby="stories-title">
    <div class="container">
      <div class="sit__head">
        <p class="eyebrow" data-reveal>Quelques histoires</p>
        <h2 id="stories-title" data-split>Nos <em>quatre pattes</em> préférés.</h2>
      </div>
      <div class="stories__grid">
        {histoires.map((h, i) => (
          <article class="story" data-reveal={String(i * 0.12)}>
            <h3>{h.name}</h3>
            <p class="caps story__tag">{h.tag}</p>
            <p>{h.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section theme-sable" aria-labelledby="tarif-title">
    <div class="container grid-2">
      <div class="flow">
        <p class="eyebrow" data-reveal>Modalités</p>
        <h2 id="tarif-title" data-split>Formée, <em>et entourée</em>.</h2>
        <p data-reveal>Je suis certifiée kinésiologue animal par l’EKTC et je poursuis ma formation par des séminaires en éthologie et en comportementalisme.</p>
        <p data-reveal>Je travaille en collaboration avec Sandrine Lapierre, éducatrice comportementaliste à Challes-les-Eaux (<a href="https://larchedenoee.com/" target="_blank" rel="noopener" class="u">L’Arche de Noée</a>) : kinésiologie et cours éducatifs se complètent bien sur le long terme.</p>
        <p class="notice" data-reveal>Une séance de kinésiologie ne se substitue pas à une consultation vétérinaire, ni au travail d’un comportementaliste ou d’un éducateur.</p>
      </div>
      <PriceTable rows={tarifs.animale} />
    </div>
  </section>

  <Faq
    items={[
      { q: 'Quels animaux accompagnez-vous ?', a: '<p>Les animaux de compagnie : chiens, chats, chevaux, et bien d’autres. N’hésitez pas à me demander.</p>' },
      { q: 'Où ont lieu les séances ?', a: '<p>Uniquement au cabinet de Bassens, 17 rue Arthur Haulotte.</p>' },
      { q: 'Dois-je être présent(e) ?', a: '<p>Oui, de préférence : la kinésiologie animale s’intéresse aussi à la relation entre votre animal et vous.</p>' },
    ]}
  />

  <CtaBooking soin="animale" title="Retrouver <em>une relation apaisée</em>." />
</Base>

<style>
  .animal__frame { max-width: 22rem; margin-left: auto; }
  .sit__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); max-width: 36rem; }
  .sit__list { display: grid; gap: 0 var(--s-8); }
  @media (min-width: 48em) { .sit__list { grid-template-columns: 1fr 1fr; } }
  .sit { padding-block: var(--s-5); border-top: 1px solid var(--line-soft); display: grid; gap: var(--s-2); max-width: none; }
  .sit h3 { font-size: var(--fs-h4); }
  .sit p { color: var(--fg-soft); }
  .stories__grid { display: grid; gap: var(--s-5); }
  @media (min-width: 48em) { .stories__grid { grid-template-columns: repeat(3, 1fr); } }
  .story { padding: var(--s-6); border-radius: var(--r-md); border: 1px solid var(--line-soft); display: grid; gap: var(--s-3); align-content: start; }
  .story h3 { font-size: var(--fs-h3); font-style: italic; }
  .story__tag { color: var(--c-sauge); }
  .u { text-decoration: underline; text-underline-offset: 0.2em; }
</style>
