---
import Base from '@layouts/Base.astro';
import { site } from '@data/site';
---

<Base title="Rendez-vous confirmé" description="Confirmation de votre rendez-vous avec Alexandra Degans." path="/reservation/confirmee" noindex noBookingBar>
  <section class="done" data-api={site.bookingApi}>
    <div class="container-text done__card">
      <img src="/brand/monogramme.svg" alt="" width="64" height="64" class="done__mark" />
      <p class="caps done__eyebrow" data-eyebrow>Un instant…</p>
      <h1 class="done__title" data-title>Vérification du paiement</h1>
      <div class="done__body" data-body><p class="muted">Nous confirmons votre réservation auprès de notre prestataire de paiement.</p></div>
      <div class="done__actions">
        <a class="btn" href="/">Retour à l’accueil</a>
        <a class="btn btn--ghost" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .done { min-height: 80svh; display: grid; place-items: center; padding: calc(var(--s-10) + 2rem) 0 var(--s-9); }
  .done__card { text-align: center; display: grid; justify-items: center; gap: var(--s-4); }
  .done__mark { width: 4rem; height: auto; opacity: 0.9; }
  .done__eyebrow { color: var(--c-sauge); }
  .done__title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h2); line-height: 1.05; margin: 0; }
  .done__body { max-width: 34rem; }
  .done__body dl { display: grid; gap: 0; text-align: left; margin: var(--s-5) 0; border-top: 1px solid var(--line-soft); }
  .done__body dl > div { display: grid; grid-template-columns: 7rem 1fr; gap: var(--s-4); padding: var(--s-3) 0; border-bottom: 1px solid var(--line-soft); }
  .done__body dt { color: var(--fg-soft); font-size: var(--fs-sm); }
  .done__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); justify-content: center; margin-top: var(--s-4); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.done');
  if (root) {
    const API = root.dataset.api!;
    const q = new URLSearchParams(location.search);
    const id = q.get('b') || '';
    const s = q.get('s') || '';
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const esc = (v: string) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const euro = (c: number) => `${(c / 100).toLocaleString('fr-FR', { minimumFractionDigits: c % 100 ? 2 : 0 })} €`;
    let tries = 0;
    const show = (eyebrow: string, title: string, body: string) => { $('[data-eyebrow]').textContent = eyebrow; $('[data-title]').textContent = title; $('[data-body]').innerHTML = body; };

    async function check() {
      try {
        const r = await fetch(`${API}/api/booking/${encodeURIComponent(id)}?s=${encodeURIComponent(s)}`);
        const b = await r.json();
        if (!r.ok) throw new Error(b.error);
        if (b.status === 'confirmed') {
          show('Merci', `À très bientôt, ${b.name.split(' ')[0]}.`, `
            <p>Votre rendez-vous est réglé et confirmé. Un e-mail récapitulatif, avec l’invitation à ajouter à votre agenda, vient de vous être envoyé.</p>
            <dl>
              <div><dt>Soin</dt><dd>${esc(b.item)}</dd></div>
              <div><dt>Date</dt><dd>${esc(b.label)}</dd></div>
              <div><dt>Lieu</dt><dd>${esc(b.place)}</dd></div>
              <div><dt>Réglé</dt><dd>${euro(b.price)}</dd></div>
            </dl>
            <p class="small muted">Annulation remboursée jusqu’à 48 h avant, depuis le lien présent dans l’e-mail.</p>`);
          return;
        }
        if (b.status === 'hold' && tries++ < 8) { setTimeout(check, 2500); return; }
        show('Paiement non finalisé', 'Votre créneau n’est pas réservé.', `<p class="muted">Le paiement n’a pas abouti. Vous pouvez <a href="/reserver" style="text-decoration:underline">recommencer la réservation</a> ou appeler Alexandra.</p>`);
      } catch {
        show('Oups', 'Réservation introuvable.', `<p class="muted">Si vous avez été débité(e), pas d’inquiétude : contactez Alexandra, elle retrouvera votre rendez-vous.</p>`);
      }
    }
    check();
  }
</script>
