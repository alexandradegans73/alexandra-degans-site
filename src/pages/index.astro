---
import Base from '@layouts/Base.astro';
import ScrollFilm from '@components/ScrollFilm.astro';
import Portrait from '@components/Portrait.astro';
import { site, branches, avis } from '@data/site';
import { media } from '@data/media';

const description =
  'Kinésiologue près de Chambéry, à Bassens et Myans : kinésiologie, soins énergétiques, drainage, kinésiologie animale. Réservation en ligne.';

const etapes = [
  { n: 'I', t: 'Écouter', d: 'Un objectif défini ensemble, qui évolue au fil des séances. Nous avançons à votre rythme.' },
  { n: 'II', t: 'Ressentir', d: 'Le test musculaire ouvre un dialogue avec le corps, là où les mots ne suffisent pas toujours.' },
  { n: 'III', t: 'Libérer', d: 'Des équilibrations douces pour alléger la charge émotionnelle et retrouver de l’élan.' },
];
---

<Base title="Accueil" description={description} path="/" heroDark>
  <ScrollFilm />

  <div class="film-page">
    {/* ---- 1. Ouverture : les racines ------------------------------- */}
    <section class="scene scene--hero" data-scene aria-label="Introduction">
      <div class="scene__inner container-wide" data-scene-inner>
        <h1 class="hero-h1">
          <span class="hero-mark"><img src="/brand/monogramme-creme.svg" alt="" width="72" height="76" /><span class="caps">Kinésiologue à Chambéry · Bassens &amp; Myans</span></span>
          <span class="hero-title">Retrouver l’équilibre, <em>à votre rythme.</em></span>
        </h1>
        <p class="lead hero-sub">Kinésiologie, soins énergétiques et drainage lymphatique à Bassens et Myans. Un accompagnement doux, précis et profondément humain.</p>
        <div class="hero-actions">
          <a class="btn btn--light" href={site.booking}>Prendre rendez-vous</a>
          <a class="link-arrow" href="#prestations">Entrer dans l’arbre
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
        </div>
      </div>
      <button class="sound" type="button" aria-pressed="false" data-sound-toggle data-src={media.ambience} data-layers={media.layers.join(',')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 10v4h3l5 4V6L7 10H4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>
        <span data-sound-label>Ambiance sonore</span>
      </button>
      <p class="scroll-hint caps" aria-hidden="true"><i></i>Défiler</p>
    </section>

    {/* ---- 2. Philosophie ------------------------------------------ */}
    <section class="scene scene--center" data-scene aria-label="Philosophie">
      <div class="scene__inner container-text" data-scene-inner>
        <p class="eyebrow">L’arbre de vie</p>
        <p class="display quote">Le corps garde la mémoire de ce que nous traversons. La kinésiologie lui donne la parole, doucement, pour <em>libérer ce qui pèse</em> et laisser revenir l’équilibre.</p>
        <p class="sign">— Alexandra Degans</p>
      </div>
    </section>

    {/* ---- 3. La kinésiologie : le tronc ---------------------------- */}
    <section class="scene scene--left" data-scene aria-labelledby="intro-title">
      <div class="scene__inner container-wide" data-scene-inner>
        <div class="panel">
          <p class="eyebrow">Entrer dans l’arbre</p>
          <h2 id="intro-title">Une approche globale, <em>douce et précise</em>.</h2>
          <p class="lead">Née de la rencontre entre la chiropractie, l’énergétique chinoise, la neurophysiologie et l’acupuncture, la kinésiologie est une technique psycho-corporelle qui s’adresse à tous les âges de la vie.</p>
          <p>Par un test musculaire léger, elle interroge la mémoire du corps pour identifier l’origine d’un blocage, libérer la charge émotionnelle qui en découle et réactiver les ressources propres à chacun.</p>
        </div>
      </div>
    </section>

    {/* ---- 4. Les cinq branches ------------------------------------ */}
    <div id="prestations" data-film-mark="0.1667">
      <section class="scene scene--center scene--short" data-scene aria-label="Les soins">
        <div class="scene__inner container-text" data-scene-inner>
          <p class="eyebrow">Six branches</p>
          <h2>Chaque branche est <em>un chemin</em> vers vous.</h2>
        </div>
      </section>

      {branches.map((p, i) => (
        <section class:list={['scene', 'scene--branch', i % 2 === 0 ? 'scene--right' : 'scene--left']} data-scene="branch" data-branch aria-labelledby={`b-${p.slug}`}>
          <div class="scene__inner container-wide">
            <article class:list={['branch', i % 2 === 0 ? 'branch--from-left' : 'branch--from-right']}>
              {/* Trait oblique qui part de la branche et vient ouvrir le cadre par son coin */}
              <span class="branch__leader" aria-hidden="true">
                <span class="branch__trace" data-branch-line><svg viewBox="0 0 100 100" preserveAspectRatio="none" fill="none"><line x1="0" y1="0" x2="100" y2="100" vector-effect="non-scaling-stroke" /></svg></span>
                <i class="branch__dot" data-branch-dot></i>
              </span>
              <div class="branch__frame" data-branch-frame>
                <div class="branch__body">
                  <header class="branch__head" data-branch-item>
                    <span class="branch__num">Branche 0{i + 1}</span>
                    <h3 id={`b-${p.slug}`} class="branch__name">{p.name}</h3>
                  </header>
                  <p class="branch__short" data-branch-item>{p.short}</p>
                  <p class="branch__intro" data-branch-item>{p.intro}</p>
                  <ul class="branch__details" role="list" data-branch-item>
                    {p.details.map((d) => (
                      <li><span class="branch__d-label">{d.label}</span>{d.duration && <span class="branch__d-duration">{d.duration}</span>}<span class="branch__d-price">{d.price}</span></li>
                    ))}
                  </ul>
                  <a class="link-arrow" href={p.path} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined} data-branch-item>{p.cta ?? 'Découvrir'}<span class="visually-hidden"> : {p.name}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                </div>
              </div>
            </article>
          </div>
        </section>
      ))}
    </div>

    {/* ---- 5. L'approche -------------------------------------------- */}
    <section class="scene scene--center" data-scene data-film-mark="0.5" aria-labelledby="approach-title">
      <div class="scene__inner container" data-scene-inner>
        <p class="eyebrow">Les feuilles</p>
        <h2 id="approach-title">Chaque séance est <em>unique</em>, parce que vous l’êtes.</h2>
        <ol class="etapes" role="list">
          {etapes.map((e) => (<li><span>{e.n}</span><h3>{e.t}</h3><p>{e.d}</p></li>))}
        </ol>
        <p class="small note">La kinésiologie ne se substitue pas à une consultation médicale, ni à un suivi vétérinaire pour les animaux.</p>
      </div>
    </section>

    {/* ---- 6. Alexandra --------------------------------------------- */}
    <section class="scene scene--center" data-scene aria-labelledby="about-title">
      <div class="scene__inner container" data-scene-inner>
        <div class="about-duo">
          <Portrait class="about-duo__portrait" sizes="(min-width: 48em) 22rem, 64vw" />
          <div class="panel about-duo__panel">
            <p class="eyebrow">Le tronc · Alexandra</p>
            <h2 id="about-title">Kinésiologue certifiée, <em>à votre écoute</em>.</h2>
            <p class="lead">Formée en kinésiologie, en thérapie par les modes oculaires, en visualisation et en Brain Gym.</p>
            <p>J’accompagne les bébés, les enfants, les adolescents et les adultes — et aussi les animaux.</p>
            <a class="link-arrow" href="/a-propos">Faire connaissance
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        </div>
      </div>
    </section>

    {/* ---- 7. Les lieux --------------------------------------------- */}
    <section class="scene scene--center" id="lieux" data-scene data-film-mark="0.6667" aria-labelledby="places-title">
      <div class="scene__inner container" data-scene-inner>
        <p class="eyebrow">Les racines · deux lieux d’ancrage</p>
        <h2 id="places-title">Bassens et Myans, <em>à quelques minutes</em> de Chambéry.</h2>
        <div class="lieux">
          {site.places.map((p) => (
            <a class="lieu" href={p.maps} target="_blank" rel="noopener">
              <h3>{p.city}</h3>
              <p>{p.street}<br />{p.zip} {p.city}</p>
              <p class="small">{p.note}</p>
              <span class="link-arrow">Itinéraire
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* ---- 8. Avis Google ------------------------------------------- */}
    <section class="scene scene--center" id="temoignages" data-scene aria-labelledby="testi-title">
      <div class="scene__inner container" data-scene-inner>
        <p class="eyebrow">Ils en parlent</p>
        <h2 id="testi-title">Des mots <em>laissés sur Google</em>.</h2>
        <div class="avis">
          {avis.items.map((t) => (
            <blockquote>
              <span class="avis__stars" role="img" aria-label="5 étoiles sur 5">★★★★★</span>
              <p>« {t.text} »</p>
              <footer>Avis Google</footer>
            </blockquote>
          ))}
        </div>
        <a class="link-arrow" href={site.googleReviews} target="_blank" rel="noopener">{avis.note} · {avis.total} avis — tout lire sur Google
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    </section>

    {/* ---- 9. L'arbre entier : rendez-vous --------------------------- */}
    <section class="scene scene--center scene--final" data-scene="stay" data-film-mark="0.8667" aria-labelledby="cta-title">
      <div class="scene__inner container-text" data-scene-inner>
        <img class="final-mono" src="/brand/monogramme-creme.svg" alt="" width="72" height="76" loading="lazy" />
        <p class="eyebrow">L’eau · le calme</p>
        <h2 id="cta-title">Prendre un temps <em>pour soi</em>.</h2>
        <p class="lead">Réservez votre séance en ligne, ou appelez-moi pour échanger sur votre besoin avant de venir.</p>
        <div class="hero-actions final-actions">
          <a class="btn btn--light" href={site.booking}>Réserver en ligne</a>
          <a class="final-phone" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Page-film : tout le contenu flotte au-dessus du film de l'arbre */
  .film-page { color: var(--c-creme); --fg: var(--c-creme); --fg-soft: var(--c-sable); --accent: var(--c-sable); --line: rgb(243 237 226 / 0.4); }
  .film-page :is(h1, h2, h3) { color: var(--c-creme); text-shadow: 0 2px 30px rgb(20 26 18 / 0.55); }
  .film-page :is(h1, h2, h3, .display) em { color: var(--c-sable); }
  .film-page p { text-shadow: 0 1px 18px rgb(20 26 18 / 0.6); }
  .film-page .eyebrow { color: var(--c-sable); }
  .film-page .link-arrow { color: var(--c-creme); }

  .scene { position: relative; min-height: 135svh; display: grid; align-items: center; padding-block: 18svh; }
  .scene--short { min-height: 90svh; }
  .scene--hero { min-height: 120svh; align-items: start; padding-top: 0; }
  .scene--hero .scene__inner { min-height: 100svh; display: grid; align-content: end; gap: var(--s-5); padding-top: calc(var(--header-h) + var(--s-4)); padding-bottom: clamp(5rem, 12vh, 8rem); }
  .scene--final { min-height: 130svh; align-items: end; padding-bottom: 22svh; }
  .scene__inner { display: grid; gap: var(--s-5); }
  .scene--center .scene__inner { text-align: center; justify-items: center; }
  .scene--left .scene__inner { justify-items: start; }
  .scene--right .scene__inner { justify-items: end; }

  /* Panneau de verre : lisible sans masquer le film */
  .panel {
    display: grid; gap: var(--s-4); width: min(100%, 31rem);
    padding: clamp(1.5rem, 3vw, 2.6rem);
    border-radius: var(--r-lg);
    background: linear-gradient(160deg, rgb(42 49 38 / 0.62), rgb(42 49 38 / 0.38));
    backdrop-filter: blur(14px) saturate(1.1); -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgb(243 237 226 / 0.16);
    box-shadow: 0 30px 80px -40px rgb(10 14 8 / 0.8);
  }
  .panel h2 { font-size: var(--fs-h3); }
  .panel p:not(.lead):not(.eyebrow) { color: var(--c-sable); }

  .hero-h1 { display: grid; gap: var(--s-5); font-size: inherit; }
  .hero-mark { display: flex; font-family: var(--font-text); line-height: 1.4; text-shadow: none; align-items: center; gap: var(--s-4); color: var(--c-sable); }
  .hero-mark img { width: 2.6rem; }
  .hero-title { display: block; font-size: clamp(2.8rem, 1.2rem + 5.2vw + 2vh, 6.6rem); line-height: 0.98; max-width: 14ch; }
  .hero-title em { display: block; }
  .hero-sub { max-width: 34rem; color: var(--c-creme); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5) var(--s-6); }
  .scroll-hint { position: absolute; left: 50%; top: calc(100svh - 3.2rem); translate: -50% 0; display: none; align-items: center; gap: var(--s-3); color: var(--c-sable); }
  .scroll-hint i { width: 1px; height: 2.4rem; background: linear-gradient(var(--c-sable), transparent); animation: hint 2.4s ease-in-out infinite; transform-origin: top; }
  @keyframes hint { 0%, 100% { transform: scaleY(0.4); opacity: 0.4; } 50% { transform: scaleY(1); opacity: 1; } }
  @media (min-width: 64em) { .scroll-hint { display: flex; } }
  .sound { position: absolute; right: var(--gutter); top: calc(100svh - 4.2rem); display: inline-flex; align-items: center; gap: var(--s-2); color: var(--c-sable); font-size: var(--fs-xs); letter-spacing: 0.18em; text-transform: uppercase; font-weight: 400; padding: var(--s-2) var(--s-3); border-radius: var(--r-pill); border: 1px solid rgb(217 202 176 / 0.4); backdrop-filter: blur(8px); }
  .sound[aria-pressed='true'] { color: var(--c-creme); background: rgb(98 112 86 / 0.5); }
  .sound svg { width: 1.1rem; height: 1.1rem; }
  @media (max-width: 63.99em) { .sound { top: calc(var(--header-h) + 0.2rem); } }

  .quote { font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3rem); line-height: 1.25; max-width: 28ch; text-shadow: 0 2px 30px rgb(20 26 18 / 0.7); }
  .sign { font-family: var(--font-display); font-style: italic; font-size: var(--fs-lg); color: var(--c-sable); }
  .scene--center h2 { max-width: 20ch; }

  /* Branche : un trait oblique part de la branche, s'allonge, puis ouvre le cadre par son coin.
     Tout suit le scroll en continu, et se replie en sens inverse quand on avance dans l'arbre. */
  .scene--branch { display: block; min-height: 230svh; padding-block: 0; }
  .scene--branch .scene__inner { position: sticky; top: 0; min-height: 100svh; align-content: center; padding-block: calc(var(--header-h) + 0.5rem) 5.5rem; }
  .branch { --lw: clamp(2.5rem, 13vw, 12rem); --lh: clamp(3rem, 15svh, 9rem); display: grid; grid-template-columns: var(--lw) minmax(0, 30rem); grid-template-rows: var(--lh) auto; width: fit-content; max-width: 100%; }
  .branch--from-right { grid-template-columns: minmax(0, 30rem) var(--lw); }
  .branch__leader { grid-column: 1; grid-row: 1; position: relative; }
  .branch--from-right .branch__leader { grid-column: 2; transform: scaleX(-1); }
  .branch__trace { position: absolute; inset: 0; display: block; }
  .branch__leader svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .branch__leader line { stroke: var(--c-creme); stroke-width: 1.5; stroke-linecap: round; filter: drop-shadow(0 0 6px rgb(243 237 226 / 0.7)); }
  .branch__dot { position: absolute; left: 0; top: 0; width: 0.6rem; height: 0.6rem; margin: -0.3rem 0 0 -0.3rem; border-radius: 50%; background: var(--c-creme); box-shadow: 0 0 0 5px rgb(243 237 226 / 0.2), 0 0 18px rgb(243 237 226 / 0.8); }
  .branch__frame {
    grid-column: 2; grid-row: 2;
    border-radius: 0 var(--r-lg) var(--r-lg) var(--r-lg);
    background: linear-gradient(170deg, rgb(42 49 38 / 0.68), rgb(42 49 38 / 0.44));
    backdrop-filter: blur(14px) saturate(1.1); -webkit-backdrop-filter: blur(14px) saturate(1.1);
    border: 1px solid rgb(243 237 226 / 0.45);
    box-shadow: 0 30px 80px -40px rgb(10 14 8 / 0.8);
  }
  .branch--from-right .branch__frame { grid-column: 1; border-radius: var(--r-lg) 0 var(--r-lg) var(--r-lg); }
  .branch__body { display: grid; gap: var(--s-4); padding: clamp(1.3rem, 3vw, 2.4rem); }
  .branch__head { display: grid; gap: var(--s-2); }
  .branch__num { font-size: var(--fs-xs); letter-spacing: var(--ls-caps-wide); text-transform: uppercase; color: var(--c-sable); }
  .branch__name { font-size: clamp(1.8rem, 1.2rem + 2vw, 2.9rem); line-height: 1.05; overflow-wrap: anywhere; hyphens: auto; }
  .branch__intro { color: var(--c-sable); }
  .branch__short { font-family: var(--font-display); font-style: italic; font-size: var(--fs-lg); }
  .branch__details { display: grid; }
  .branch__details li { display: flex; justify-content: space-between; gap: var(--s-4); align-items: baseline; padding-block: var(--s-3); border-top: 1px solid rgb(243 237 226 / 0.16); max-width: none; }
  .branch__details li:last-child { border-bottom: 1px solid rgb(243 237 226 / 0.16); }
  .branch__d-label { font-family: var(--font-display); font-size: var(--fs-lg); }
  .branch__d-label { flex: 1; }
  .branch__d-duration { font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-sable); white-space: nowrap; }
  .branch__d-price { font-family: var(--font-display); font-size: var(--fs-h4); min-width: 3em; text-align: right; white-space: nowrap; }

  .etapes { display: grid; gap: var(--s-4); margin-top: var(--s-5); width: 100%; text-align: left; }
  @media (min-width: 48em) { .etapes { grid-template-columns: repeat(3, 1fr); } }
  .etapes li, .lieu, .avis blockquote {
    padding: var(--s-6); border-radius: var(--r-md); display: grid; gap: var(--s-2); align-content: start; max-width: none;
    background: rgb(42 49 38 / 0.5); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgb(243 237 226 / 0.14);
  }
  .etapes span { font-family: var(--font-display); font-size: var(--fs-h3); color: var(--c-sauge-claire); line-height: 1; }
  .etapes h3 { font-size: var(--fs-h4); }
  .etapes p, .lieu p, .avis footer { color: var(--c-sable); }
  .note { color: var(--c-sable); opacity: 0.85; max-width: none; }

  .lieux, .avis { display: grid; gap: var(--s-4); margin-top: var(--s-5); width: 100%; text-align: left; }
  @media (min-width: 48em) { .lieux { grid-template-columns: 1fr 1fr; max-width: 46rem; } .avis { grid-template-columns: repeat(3, 1fr); } }
  .lieu h3 { font-size: var(--fs-h3); }
  .lieu { transition: border-color var(--t-base); }
  .lieu:hover { border-color: rgb(243 237 226 / 0.45); }
  .avis blockquote { align-content: space-between; gap: var(--s-4); min-height: 13rem; }
  .avis blockquote p { font-family: var(--font-display); font-size: var(--fs-h4); line-height: 1.3; font-style: italic; }
  .avis__stars { color: var(--c-sable); letter-spacing: 0.25em; font-size: var(--fs-sm); }
  .avis footer { font-size: var(--fs-xs); letter-spacing: var(--ls-caps); text-transform: uppercase; }

  .about-duo { display: grid; gap: var(--s-5); align-items: end; text-align: left; width: 100%; justify-items: center; }
  .about-duo :global(.about-duo__portrait) { width: min(64vw, 17rem); }
  .about-duo__panel { width: 100%; }
  @media (min-width: 48em) {
    .about-duo { grid-template-columns: minmax(0, 22rem) minmax(0, 31rem); justify-content: center; gap: var(--s-6); }
    .about-duo :global(.about-duo__portrait) { width: 100%; }
  }
  .final-mono { width: 3rem; opacity: 0.85; }
  .final-actions { justify-content: center; }
  .final-phone { font-family: var(--font-display); font-size: var(--fs-h4); }

  @media (max-width: 47.99em) {
    .scene { min-height: 115svh; padding-block: 14svh; }
    .scene--branch { min-height: 220svh; padding-block: 0; }
    .scene--left .scene__inner, .scene--right .scene__inner { justify-items: stretch; }
    .panel { width: 100%; }
    .branch { --lw: 2.2rem; --lh: 3.2rem; width: 100%; grid-template-columns: var(--lw) minmax(0, 1fr); }
    .branch--from-right { grid-template-columns: minmax(0, 1fr) var(--lw); }
    .branch__intro { font-size: var(--fs-sm); }
  }
  @media (prefers-reduced-motion: reduce) { .scene { min-height: 0; padding-block: var(--s-9); } .scene--branch { min-height: 0; } .scene--branch .scene__inner { position: static; min-height: 0; padding-block: var(--s-7); } .scroll-hint i { animation: none; } }
</style>

<style is:global>
  /* En-tête sur la page-film : reste sombre et translucide */
  body[data-hero-dark] .site-header.is-scrolled { --hdr-fg: var(--c-creme); background: rgb(42 49 38 / 0.55); box-shadow: 0 1px 0 rgb(243 237 226 / 0.12); }
  body[data-hero-dark] .site-header.is-scrolled .brand--light { display: none; }
  body[data-hero-dark] .site-header.is-scrolled .brand--dark { display: block; }
  body[data-hero-dark] .site-header.is-scrolled .site-header__cta { --btn-fg: var(--c-creme); border-color: rgb(243 237 226 / 0.5); }
  body[data-hero-dark] { background: var(--c-foret-900); }
  body[data-hero-dark] .footer { position: relative; z-index: 1; }
</style>
