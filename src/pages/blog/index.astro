---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import PageHero from '@components/PageHero.astro';
import CtaBooking from '@components/CtaBooking.astro';
import { site } from '@data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.date <= new Date()))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${site.url}/blog#blog`,
  name: 'Le Journal d’Alexandra Degans',
  url: `${site.url}/blog`,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${site.url}/#business` },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${site.url}/blog/${p.id}`, datePublished: p.data.date.toISOString() })),
};
---

<Base
  title="Journal : kinésiologie et bien-être à Chambéry"
  description="Le journal d’Alexandra Degans, kinésiologue à Bassens et Myans près de Chambéry : comprendre la kinésiologie, les soins et leur déroulé."
  path="/blog"
  heroDark
  schema={schema}
>
  <PageHero
    scene="feuilles"
    eyebrow="Journal · kinésiologie & bien-être"
    title="Prendre le temps <em>de comprendre</em>."
    intro="Des articles simples et sincères pour découvrir la kinésiologie, les soins énergétiques et le drainage, et savoir à quoi vous attendre avant de venir."
  />

  <section class="section" aria-label="Articles">
    <div class="container">
      {posts.length === 0 && <p class="lead">Les premiers articles arrivent bientôt.</p>}
      <ol class="posts" role="list">
        {posts.map((p, i) => (
          <li class="post" data-reveal={String((i % 3) * 0.06)}>
            <a href={`/blog/${p.id}`} class="post__link">
              <img src={`/media/scenes/${p.data.scene}.webp`} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
              <div class="post__body">
                <p class="small muted"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></p>
                <h2 class="post__title">{p.data.title}</h2>
                <p class="muted">{p.data.description}</p>
                <span class="link-arrow">Lire l’article</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBooking />
</Base>

<style>
  .posts { display: grid; gap: var(--s-8); }
  @media (min-width: 48em) { .posts { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72em) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .post__link { display: grid; gap: var(--s-4); color: inherit; text-decoration: none; }
  .post__link img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-lg); transition: transform var(--t-slow, 0.8s) var(--ease-out); }
  .post__link:hover img, .post__link:focus-visible img { transform: scale(1.02); }
  .post__body { display: grid; gap: var(--s-3); }
  .post__title { font-size: var(--fs-h3); }
</style>
