---
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BookingBar from '@components/BookingBar.astro';
import { site } from '@data/site';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique, ex. "/kinesiologie" */
  path?: string;
  image?: string;
  /** En-tête transparent sur un hero sombre/immersif */
  heroDark?: boolean;
  /** Données structurées additionnelles (JSON-LD) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, path = '/', image = '/og-image.png', heroDark = false, schema, noindex = false } = Astro.props;
const canonical = new URL(path === '/' ? '/' : path, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle = path === '/' ? `${site.name} · Kinésiologue à Chambéry (Bassens & Myans)` : `${title} · ${site.name}`;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  '@id': `${site.url}/#business`,
  name: `${site.name} · Kinésiologie`,
  url: site.url,
  telephone: '+33676647909',
  email: site.email,
  image: ogImage,
  logo: `${site.url}/brand/logo-vertical.svg`,
  description:
    'Kinésiologue à Bassens et Myans, près de Chambéry : kinésiologie, libération des mémoires transgénérationnelles, kinésiologie animale, soins énergétiques visage et corps, drainage lymphatique.',
  priceRange: '60 € – 140 €',
  areaServed: ['Chambéry', 'Bassens', 'Myans', 'Savoie'],
  location: site.places.map((p) => ({
    '@type': 'Place',
    name: `${site.name} — ${p.name}`,
    address: { '@type': 'PostalAddress', streetAddress: p.street, postalCode: p.zip, addressLocality: p.city, addressCountry: 'FR' },
    geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lng },
  })),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Saturday'], opens: '09:00', closes: '14:30' },
  ],
  founder: { '@type': 'Person', name: site.name, jobTitle: 'Kinésiologue' },
  memberOf: [
    { '@type': 'Organization', name: 'Fédération de la Kinésiologie Professionnelle' },
    { '@type': 'Organization', name: 'Fédération Française des Pratiques Alternatives Professionnelles' },
  ],
};
const schemas = [business, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f3ede2" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/cormorant-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jost-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>
  <body data-hero-dark={heroDark ? 'true' : undefined}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header dark={heroDark} />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <BookingBar />
    <script>
      import '@scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed; top: var(--s-3); left: var(--s-3); z-index: 100;
    padding: var(--s-3) var(--s-5); background: var(--c-foret); color: var(--c-creme);
    border-radius: var(--r-pill); transform: translateY(-200%);
    transition: transform var(--t-fast) var(--ease-out);
  }
  .skip-link:focus { transform: none; }
</style>
