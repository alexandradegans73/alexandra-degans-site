---
/** Barre de réservation mobile : toujours accessible au pouce. */
import { site } from '@data/site';
---
<div class="booking-bar" data-booking-bar>
  <a class="booking-bar__call" href={site.phoneHref} aria-label={`Appeler ${site.phone}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6.2 6.2l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
  </a>
  <a class="btn booking-bar__btn" href={site.booking}>Prendre rendez-vous</a>
</div>

<style>
  .booking-bar {
    position: fixed; z-index: var(--z-header); left: 50%; bottom: max(0.9rem, env(safe-area-inset-bottom));
    transform: translate(-50%, 0);
    display: flex; align-items: center; gap: var(--s-2);
    padding: 0.4rem; border-radius: var(--r-pill);
    background: color-mix(in oklab, var(--c-creme) 88%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: var(--shadow-lift), 0 0 0 1px var(--line-soft);
    transition: transform var(--t-base) var(--ease-out), opacity var(--t-base);
  }
  .booking-bar.is-hidden { transform: translate(-50%, 160%); opacity: 0; }
  .booking-bar__call {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--c-sable); color: var(--c-foret);
  }
  .booking-bar__call svg { width: 20px; height: 20px; }
  .booking-bar__btn { padding-block: 0.8em; white-space: nowrap; }
  .booking-bar { max-width: calc(100vw - 1.5rem); }
  @media (max-width: 22em) { .booking-bar__btn { padding-inline: 1.2em; letter-spacing: 0.08em; } }
  @media (min-width: 64em) { .booking-bar { display: none; } }
</style>
