---
/** En-tête éditorial des pages intérieures. */
interface Props {
  eyebrow: string;
  title: string;      // peut contenir <em>
  intro?: string;
  tone?: 'creme' | 'sable' | 'dark';
  number?: string;
  /** Scène du film de l'arbre affichée en fond : arbre, branches, feuilles, racines, eau */
  scene?: 'arbre' | 'branches' | 'feuilles' | 'racines' | 'eau';
}
const { eyebrow, title, intro, number, scene } = Astro.props;
const tone = scene ? 'dark' : (Astro.props.tone ?? 'creme');
---
<header class:list={['page-hero', `tone-${tone}`, { 'theme-dark': tone === 'dark', 'theme-sable': tone === 'sable', 'has-scene': scene }]}>
  {scene && <div class="page-hero__scene" aria-hidden="true"><img src={`/media/scenes/${scene}.webp`} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" data-parallax="14" /></div>}
  <div class="container page-hero__inner">
    <div class="page-hero__text">
      <h1 class="page-hero__h1">
        <span class="eyebrow" data-reveal>{eyebrow}</span>
        <span class="page-hero__title" data-split set:html={title} />
      </h1>
      {intro && <p class="lead page-hero__intro" data-reveal="0.2">{intro}</p>}
    </div>
    {number && <span class="page-hero__num" aria-hidden="true">{number}</span>}
    <div class="page-hero__visual" data-reveal="0.3">
      <slot name="visual" />
    </div>
  </div>
  <svg class="page-hero__branch" viewBox="0 0 400 300" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <path d="M-10 290 C 80 230, 140 200, 230 120 C 280 80, 330 60, 420 20" />
    <path d="M120 215 C 140 180, 170 170, 200 165" stroke-width="1.4" />
    <path d="M230 120 C 225 90, 240 70, 260 50" stroke-width="1.4" />
    <path d="M300 75 C 330 70, 350 80, 370 95" stroke-width="1.4" />
  </svg>
</header>

<style>
  .page-hero { position: relative; overflow: clip; padding: calc(var(--header-h) + var(--s-9)) 0 var(--s-9); }
  .has-scene { min-height: 88svh; display: grid; align-items: end; isolation: isolate; }
  .page-hero__scene { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .page-hero__scene img { width: 100%; height: 116%; object-fit: cover; }
  .page-hero__scene::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(30 36 27 / 0.55), rgb(30 36 27 / 0.2) 35%, rgb(30 36 27 / 0.82)); }
  .has-scene .page-hero__branch, .has-scene .page-hero__num { display: none; }
  .has-scene .eyebrow { color: var(--c-sable); }
  .has-scene .eyebrow::before { background: var(--c-sable); }
  .has-scene :global(h1) { text-shadow: 0 2px 30px rgb(20 26 18 / 0.55); }
  .has-scene :global(h1 em) { color: var(--c-sable); }
  .has-scene .page-hero__intro { color: var(--c-creme); text-shadow: 0 1px 18px rgb(20 26 18 / 0.6); }
  .page-hero__inner { display: grid; gap: var(--s-7); position: relative; align-items: end; }
  @media (min-width: 64em) { .page-hero__inner { grid-template-columns: 1.15fr 0.85fr; } }
  .page-hero__text { display: grid; gap: var(--s-5); }
  .page-hero__h1 { display: grid; gap: var(--s-5); justify-items: start; }
  .page-hero__h1 .eyebrow { line-height: 1.4; text-shadow: 0 1px 14px rgb(20 26 18 / 0.75); }
  .page-hero__title { display: block; }
  .page-hero__intro { max-width: 34rem; }
  .page-hero__num { position: absolute; right: 0; top: -2rem; font-family: var(--font-display); font-size: clamp(5rem, 14vw, 12rem); line-height: 1; color: var(--c-sauge-claire); opacity: 0.35; pointer-events: none; }
  .page-hero__visual:empty { display: none; }
  .page-hero__branch { position: absolute; left: 0; bottom: -2rem; width: min(40rem, 60vw); color: var(--c-sauge-claire); opacity: 0.5; pointer-events: none; }
  .tone-dark .page-hero__branch { opacity: 0.3; }
</style>
